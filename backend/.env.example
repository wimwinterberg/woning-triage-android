# In all environments, the following files are loaded if they exist.
# Do not put production secrets here.

APP_ENV=dev
APP_SECRET=change-me
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost:8000

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
DATABASE_URL="postgresql://woningtriage:woningtriage@127.0.0.1:5432/woningtriage?serverVersion=16&charset=utf8"

CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# Leave empty to disable GPT-Live. Text intake still works.
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1

# pdok | fake  — fake never presents results as live BAG data in production.
ADDRESS_PROVIDER=fake

# Optional path to Wim's 53 MB catalog. Not in git.
CLASSIFICATION_IMPORT_PATH=
