# In all environments, the following files are loaded if they exist.
# Do not put production secrets here.

APP_ENV=dev
APP_SECRET=change-me
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost:8000

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
DATABASE_URL="postgresql://woningtriage:woningtriage@127.0.0.1:5432/woningtriage?serverVersion=16&charset=utf8"

CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$|^https://[a-z0-9.-]+\.ngrok(-free)?\.(app|dev|io)$'

# Leave empty to disable GPT-Live. Text intake still works.
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1

# Dutch postcodes only (nl). Put WCS_ADDRESS_API_KEY in this file (not only .env.local)
# so Compose interpolates it. Address lookup always uses We Create Solutions.
WCS_ADDRESS_API_KEY=

# Optional path to Wim's 53 MB catalog. Not in git.
CLASSIFICATION_IMPORT_PATH=

# DigitalOcean App Platform (set as real env vars, not in git):
# APP_ENV=prod
# APP_DEBUG=0
# APP_SECRET=<openssl rand -hex 32>
# DATABASE_URL from ${db.DATABASE_URL} (sslmode=require, PostgreSQL 16)
# DEFAULT_URI=${api.PUBLIC_URL}
# WCS_ADDRESS_API_KEY=<secret>
# OPENAI_API_KEY=<secret>
# Optional ngrok authtoken for `docker compose --profile ngrok up`.
# NGROK_AUTHTOKEN=
